# ── Polymarket ────────────────────────────────────────────
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# ── Binance (aucune auth requise) ─────────────────────────
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# ── Cloudflare R2 ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=polymarket-btc-data
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# ── Scraper ────────────────────────────────────────────────
DISCOVER_INTERVAL_SEC=15       # poll Gamma pour nouveaux marchés
TICK_INTERVAL_SEC=1            # fréquence snapshot order book
FLUSH_INTERVAL_SEC=60          # buffer mémoire → DuckDB → Parquet
UPLOAD_INTERVAL_SEC=300        # flush local → R2

# ── Telegram (optionnel) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logs ──────────────────────────────────────────────────
LOG_LEVEL=INFO
